<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        layout="@layout/toolbar_personalizada"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DETALLE DEL PRODUCTO"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingBottom="24dp"/>

        <TextView
            android:id="@+id/txtDetalleNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre del producto"
            android:textSize="28sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/txtDetallePrecio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="$0.00"
            android:textSize="24sp"
            android:textStyle="bold"
            android:paddingTop="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descripción"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingTop="32dp"/>

        <TextView
            android:id="@+id/txtDetalleDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descripción del producto"
            android:textSize="16sp"
            android:paddingTop="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Categoría"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingTop="24dp"/>

        <TextView
            android:id="@+id/txtDetalleCategoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Categoría del producto"
            android:textSize="16sp"
            android:paddingTop="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Restaurante"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingTop="24dp"/>

        <TextView
            android:id="@+id/txtDetalleRestaurante"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre del restaurante"
            android:textSize="16sp"
            android:paddingTop="8dp"/>
        </LinearLayout>

    </ScrollView>

</LinearLayout>